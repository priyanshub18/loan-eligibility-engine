# ============================================================================
# Copy to .env and fill in.  `cp .env.example .env`
# ============================================================================

# ---- Local Postgres (stand-in for RDS; used by docker compose + local/dev_server.py)
APP_DB_USER=loanadmin
APP_DB_NAME=loanengine
APP_DB_PASSWORD=change-me-local-db
APP_DB_PORT=5433

# ---- Database n8n's workflows talk to
# Local: app-db (docker network).  AWS: your RDS endpoint + password from Secrets Manager, SSL=require
N8N_DB_HOST=app-db
N8N_DB_PORT=5432
N8N_DB_NAME=loanengine
N8N_DB_USER=loanadmin
# N8N_DB_PASSWORD=        # defaults to APP_DB_PASSWORD
N8N_DB_SSL=disable

# ---- n8n
# generate with: openssl rand -hex 24
N8N_ENCRYPTION_KEY=replace-with-random-hex
# shared secret Lambda/dev-server send in X-Webhook-Token (openssl rand -hex 24)
N8N_WEBHOOK_TOKEN=replace-with-random-hex
# public URL when n8n is exposed via tunnel, e.g. https://abc.trycloudflare.com/
# N8N_PUBLIC_URL=

# ---- Email (n8n Workflow C) - AWS SES node by default
# false = AWS SES (what the brief asks for). true = Gmail SMTP fallback (needs an App Password).
EMAIL_USE_GMAIL=false
EMAIL_FROM_NAME="Loan Eligibility Engine"

# AWS SES: IAM user with only ses:SendEmail/ses:SendRawEmail (see README 3.4, step 1)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# must be a verified SES identity (sandbox: the aliases below must be verified too)
SES_FROM_EMAIL=yourname@gmail.com
# Every email is redirected to these aliases (round-robin). NEVER the CSV addresses.
TEST_INBOX_ALIASES=yourname+one@gmail.com,yourname+two@gmail.com
NOTIFY_MAX_EMAILS=3

# Gmail SMTP fallback only (Google Account -> Security -> 2-Step Verification -> App passwords)
GMAIL_SMTP_USER=yourname@gmail.com
GMAIL_SMTP_APP_PASSWORD=

# ---- LLM: any OpenAI-compatible chat-completions endpoint (leave key empty to run rules-only)
# Gemini (free tier):  https://generativelanguage.googleapis.com/v1beta/openai   model gemini-3.5-flash-lite
# Groq (free tier):    https://api.groq.com/openai/v1                           model llama-3.3-70b-versatile
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_MAX_CALLS_PER_RUN=20
MAX_MATCHES_PER_USER=5

# ---- Dashboard (frontend/index.html reads workflow runs through the n8n public API)
# n8n-init provisions this key for the n8n owner (generate with: echo n8n_api_$(openssl rand -hex 24))
N8N_API_KEY=n8n_api_replace-with-random-hex
